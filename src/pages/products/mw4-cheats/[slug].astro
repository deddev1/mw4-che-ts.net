---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllProductSlugs, getProductPage, productHub } from '../../../data/products';
import { DEFAULT_OG_IMAGE, DEFAULT_OG_IMAGE_ALT, pageTitle } from '../../../config/seo';
import { getPageSeoEntry } from '../../../config/pageSeo';
import { breadcrumbSchema, productSchema } from '../../../utils/schema';
import { getProductPlans } from '../../../data/productPricing';
import ProductDetail from '../../../components/ProductDetail.astro';

export function getStaticPaths() {
  return getAllProductSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const product = getProductPage(slug!);

if (!product) {
  return Astro.redirect(productHub.path);
}

const pagePath = `${productHub.path}${product.slug}/`;
const seoEntry = getPageSeoEntry(pagePath);
const metaTitle = seoEntry?.title ?? pageTitle(product.title);
const metaDescription = seoEntry?.description ?? product.desc;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
  { name: product.title, path: pagePath },
];
const heroImage = product.images[0];
const plans = getProductPlans(product.slug);
const planPrices = plans.map((p) => p.priceUsd);
const priceLow = Math.min(...planPrices);
const priceHigh = Math.max(...planPrices);
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  ogImage={heroImage?.src ?? DEFAULT_OG_IMAGE}
  ogImageAlt={heroImage?.alt ?? DEFAULT_OG_IMAGE_ALT}
  jsonLd={[
    productSchema({
      name: product.title,
      description: product.desc,
      url: pagePath,
      offerUrl: product.buyUrl,
      image: product.images[0]?.src,
      sku: product.slug,
      priceLow,
      priceHigh,
      offerCount: plans.length,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />
</BaseLayout>
