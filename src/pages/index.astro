---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { itemListSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getFaqTopicItemList } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';

const seo = resolvePageSeo('/');
const heroLcpImage = webpSrc('/images/gameplay/mw4-gameplay-01.png', 512);
const faqTopicLinks = getFaqTopicItemList();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[websiteSchema(), organizationSchema(), itemListSchema(faqTopicLinks)]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
